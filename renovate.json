{
  "extends": [
    "config:base",
    ":disableDependencyDashboard",
    ":maintainLockFilesWeekly"
  ],
  "constraints": {
    "bun": "1.4.4"
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "lockFileMaintenance"],
      "groupName": "All non-major"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src/docker-registry\\.ts$/"],
      "matchStrings": ["// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+const \\w+ = \"[^:\"]+:(?<currentValue>[^\"]+)\";"]
    }
  ]
}
